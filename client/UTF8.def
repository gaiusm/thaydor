DEFINITION MODULE UTF8 ;  (*!m2iso+gm2*)

(*
    Title      : UTF8
    Author     : Gaius Mulley
    System     : GNU Modula-2
    Date       : Wed May 27 11:50:33 2026
    Revision   : $Version$
    Description: Provides basic UTF8 character creation and destruction.
*)

FROM FIO IMPORT File ;
FROM DynamicStrings IMPORT String ;
FROM SYSTEM IMPORT CARDINAL32 ;

CONST
   MAXUTF8 = 2097152-1 ;  (* 2^21-1 unicode characters.  *)

TYPE
   UTF8 = CARDINAL32 ;


(*
   InitUnicode - initialize a UTF8 object using an array of char.
                 For example 'U+1F9F1'.
*)

PROCEDURE InitUnicode (a: ARRAY OF CHAR) : UTF8 ;


(*
   StringInitUTF8 - init a single unicode object defined in string
                    to a UTF8 object.
*)

PROCEDURE StringInitUTF8 (s: String) : UTF8 ;


(*
   Write - write a UTF8 object to file f.
*)

PROCEDURE Write (f: File; utf8: UTF8) ;


(*
   WriteLn - write a newline to file f.
*)

PROCEDURE WriteLn (f: File) ;


END UTF8.
