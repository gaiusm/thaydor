IMPLEMENTATION MODULE AdvCheckpoint ;


CONST
   MaxBufferSize = 1024 ;
   Version = "1.0" ;

TYPE
   Buffer = POINTER TO RECORD
                          buf    : ARRAY [0..MaxBufferSize] OF CHAR ;
                          nextpos: CARDINAL ;
                          next   : Buffer ;
                       END ;

   Slot: ARRAY [0..MaxPlayers] OF Buffer ;
   Enabled: BOOLEAN ;
   CPFile : File ;


(*
   CreateNewFile - creates a new checkpoint file in dir.
*)

PROCEDURE CreateNewFile (dir: String) ;
VAR
   name: String ;
   i   : CARDINAL ;
BEGIN
   i := 0 ;
   name := NIL ;
   REPEAT
      INC (i) ;
      IF name # NIL
      THEN
         name := KillString (name)
      END ;
      name := Sprintf2 (InitString ('%s/%06d.cpt'), dir, i) ;
   UNTIL NOT Exists (name) ;
   IF Verbose
   THEN
      ARRAROFCHAR.Write (StdOut, 'checkpointing to file: ') ;
      String.Write (StdOut, name) ; String.WriteLn (StdOut)
   END ;
   CPFile := SFIO.OpenToWrite (name) ;
   FIO.WriteString (CPFile, "protocol version ") ;
   FIO.WriteString (CPFile, Version) ;
   FIO.WriteLn (CPFile) ;
   FIO.FlushBuffer (CPFile) ;
   name := KillString (name)
END CreateNewFile ;


(*
   CheckpointEnable - enable/disable checkpointing.
*)

PROCEDURE CheckpointEnable (on: BOOLEAN; dir: String) ;
BEGIN
   Enabled := on ;
   IF Enabled
   THEN
      IF IsDir (dir)
      THEN
         CreateNewFile (dir)
      ELSE
         printf ("checkpoint directory does not exist\n") ;
         exit (1)
      END
   END
END CheckpointEnable ;


(*
   CheckpointWrite - capture a single character of the frame
                     and buffer it until a checkpoint is reached.
*)

PROCEDURE CheckpointWrite (ch: CHAR) ;
VAR
   p   : CARDINAL ;
   bptr: Buffer ;
BEGIN
   IF Enabled
   THEN
      p := ProcessToPlayer () ;
      bptr := FindNonEmpty (Slot[p]) ;
      bptr^.buf[bptr^.nextpos] := ch ;
      INC (bptr^.nextpos)
   END
END CheckpointWrite ;


(*
   FindNonEmpty - return the first non empty slot.
*)

PROCEDURE FindNonEmpty (bptr: Buffer) : Buffer ;
BEGIN
   WHILE bptr^.nextpos = MaxBufferSize DO
      IF bptr^.next = NIL
      THEN
         NEW (bptr^.next) ;
         Initialize (bptr^.next) ;
      END ;
      bptr := bptr^.next
   END ;
   RETURN bptr
END FindNonEmpty ;


(*
   Initialize - initialize bptr to empty.
*)

PROCEDURE Initialize (bptr: Buffer) ;
BEGIN
   WITH bptr^ DO
      nextpos := 0 ;
      next := NIL
   END
END Initialize ;


(*
   CheckpointReset - empty all buffers belonging to calling player.
*)

PROCEDURE CheckpointReset ;
VAR
   p   : CARDINAL ;
   bptr: Buffer ;
BEGIN
   IF Enabled
   THEN
      p := ProcessToPlayer () ;
      bptr := Slot[p] ;
      WHILE bptr # NIL DO
         bptr^.nextpos := 0 ;
         bptr := bptr^.next
      END
   END
END CheckpointReset ;


(*
   CheckpointKill - flush the checkpoint buffer and tag it as a kill.
                    Player killed someone, record it.
*)

PROCEDURE CheckpointKill ;
BEGIN
   IF Enabled
   THEN
      CheckpointDump ('kill')
   END
END CheckpointKill ;


(*
   CheckpointDump -
*)

PROCEDURE CheckpointDump (str: ARRAY OF CHAR) ;
BEGIN
   writeString ('<') ;
   writeString (a) ;
   writeString ('>\n') ;
   writePlayer ;
   writeBuffer ;
   writeString ('</') ;
   writeString (a) ;
   writeString ('>\n') ;
   CheckpointReset
END CheckpointDump ;


(*
   CheckpointDied - reset the checkpoint buffer.
*)

PROCEDURE CheckpointDied ;
BEGIN
   IF Enabled
   THEN
      (* Player was killed, we ignore the checkpoint history.  *)
      CheckpointReset
   END
END CheckpointDied ;


(*
   CheckpointNewRoom - player has moved into a new room tag this as a newroom.
*)

PROCEDURE CheckpointNewRoom ;
BEGIN
   IF Enabled
   THEN
      CheckpointDump ('newroom')
   END
END CheckpointNewRoom ;


(*
   CheckpointInit - initialize the checkpoint buffer for player.
*)

PROCEDURE CheckpointInit ;
VAR
   p: CARDINAL ;
BEGIN
   IF Enabled
   THEN
      p := ProcessToPlayer () ;
      CheckpointReset
   END
END CheckpointInit ;


(*
   CheckpointStatus - write out checkpoint status.
*)

PROCEDURE CheckpointStatus ;
BEGIN
   IF Enabled
   THEN

   END
END CheckpointStatus ;


(*
   CheckpointFinish - flush any pending checkpoints and terminate the game server.
*)

PROCEDURE CheckpointFinish ;
BEGIN
   HALT (0)
END CheckpointFinish ;


(*
   Init -
*)

PROCEDURE Init ;
VAR
   i: CARDINAL ;
BEGIN
   CheckpointEnable (FALSE, NIL) ;
   FOR i := 0 TO MaxNoOfPlayers DO
      Slot[i] := NIL
   END
END Init ;


BEGIN
   Init
END AdvCheckpoint.
